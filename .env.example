# Cloud Resume Project - Environment Variables Template
# Copy this file to .env and fill in your values (DO NOT commit .env to git)

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1
AWS_PROFILE=default
AWS_ACCOUNT_ID=your-aws-account-id

# ============================================
# S3 Configuration
# ============================================
S3_BUCKET_NAME=your-unique-bucket-name-here
# CloudFront distribution ID (if using CloudFront)
CLOUDFRONT_DISTRIBUTION_ID=

# ============================================
# Terraform Configuration
# ============================================
# Backend state bucket (must be created manually first)
TF_STATE_BUCKET=your-terraform-state-bucket
TF_STATE_KEY=cloud-resume/terraform.tfstate
TF_STATE_REGION=us-east-1
# Optional: DynamoDB table for state locking
TF_STATE_DYNAMODB_TABLE=terraform-state-lock

# ============================================
# API Configuration
# ============================================
API_STAGE_NAME=prod
API_GATEWAY_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod

# ============================================
# DynamoDB Configuration
# ============================================
DYNAMODB_TABLE_NAME=resume-visitor-counter
DYNAMODB_REGION=us-east-1

# ============================================
# Development & Testing
# ============================================
LOCAL_API_URL=http://localhost:3000/visitor-count
NODE_ENV=development

# ============================================
# GitHub Actions Secrets (set in repository settings)
# ============================================
# These should be set as GitHub Secrets, not in .env
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# GITHUB_TOKEN (automatically provided)

# ============================================
# Project Metadata
# ============================================
PROJECT_NAME=cloud-resume-project
GITHUB_REPOSITORY=adusei2023/cloud-resume-project
PROJECT_VERSION=2.0.0

